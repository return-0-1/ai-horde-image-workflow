# ============================================================
# AI Horde 图像生成工作流 — 环境变量配置模板
# ============================================================
# 使用方法:
#   1. 复制此文件为 .env
#      cp .env.example .env
#   2. 填写实际值
#   3. 运行前执行:  source .env  (Linux/Mac)  或手动设置
#   4. 注意: .env 包含敏感信息，不要提交到 Git
#
# config.yaml 中的对应项优先级:
#   config.yaml 中的值 > 环境变量 > 代码默认值
#   若 config.yaml 中 api_key 为空字符串，则回退读取环境变量
# ============================================================


# ---- AI Horde API (https://aihorde.net) ----
# 在 https://aihorde.net/register 注册获取
AI_HORDE_API_KEY=your_api_key_here


# ---- LLM API (OpenAI 兼容接口) ----
# 支持 OpenAI / OpenRouter / 本地 Ollama / 自定义兼容 API
# config.yaml 中 llm.api_base 可自定义 API 地址
OPENAI_API_KEY=sk-your_api_key_here
# OPENAI_API_BASE=https://api.openai.com/v1   # config.yaml 中已配置，此处备选


# ---- 网络代理（可选，国内访问 HuggingFace / CivitAI / AI Horde 等需要） ----
# 【推荐】用项目专用变量，只有本项目的 HTTP 客户端读它，不会影响宿主/其他程序：
#   支持**候选列表**（逗号/分号/空格分隔），按顺序尝试，谁先连通就记住谁，
#   后面的请求直接走它；候选全不通才回退直连。宿主与容器可以共用同一行：
#     WORKFLOW_PROXY=http://127.0.0.1:20881,http://host.docker.internal:20881
#      （容器里 127.0.0.1 秒拒 → 自动跳到 host.docker.internal；宿主反之）
#   WORKFLOW_PROXY=none   强制直连（忽略下面那些通用代理变量）
# 端口填 v2rayN 的 HTTP 入站端口（设置 → 参数设置 → 本地监听端口）。
# v2rayN 的 http 入站是自动生成的 = socks 端口 + 1（socks 端口一变它跟着变，
# 例如 10808/10809 → 20880/20881），所以别把端口当常量写进代码，改这里即可。
# 代理连不上时会自动回退下一个候选/直连（GET/下载）；POST 仅在确认「请求未发出」
# 时回退，以免重复提交任务重复扣 kudos。
#
# 下面这几个是通用变量，仅作兜底（优先级低于 WORKFLOW_PROXY）：
# 注意它们会被 python-dotenv 写进整个进程环境，连带宿主/同进程其他程序也走代理。
# HTTP_PROXY=http://127.0.0.1:10809
# HTTPS_PROXY=http://127.0.0.1:10809
# NO_PROXY=localhost,127.0.0.1,.local
# WORKFLOW_PROXY=http://127.0.0.1:10809


# ---- HuggingFace 镜像（可选，国内加速模型下载） ----
# 若工作流中涉及模型下载，可设置国内镜像
# HF_ENDPOINT=https://hf-mirror.com


# ---- 输出目录覆盖（可选） ----
# 会覆盖 config.yaml 中的 output.directory
# Docker 容器内请填容器路径，例如 /AstrBot/data/output
# （写进 config.yaml 会导致每次 git pull 冲突，放这里更合适）
# OUTPUT_DIR=my_output

# ---- 日志文件/级别覆盖（可选） ----
# LOG_FILE 会覆盖 config.yaml 中的 logging.file
# LOG_LEVEL 会覆盖 config.yaml 中的 logging.level
# LOG_FILE=/AstrBot/data/workflow.log
# LOG_LEVEL=DEBUG
