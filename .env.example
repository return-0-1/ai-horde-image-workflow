# ============================================================
# AI Horde 图像生成工作流 — 环境变量配置模板
# ============================================================
# 使用方法:
#   1. 复制此文件为 .env
#      cp .env.example .env
#   2. 填写实际值
#   3. 运行前执行:  source .env  (Linux/Mac)  或手动设置
#   4. 注意: .env 包含敏感信息，不要提交到 Git
#
# config.yaml 中的对应项优先级:
#   config.yaml 中的值 > 环境变量 > 代码默认值
#   若 config.yaml 中 api_key 为空字符串，则回退读取环境变量
# ============================================================


# ---- AI Horde API (https://aihorde.net) ----
# 在 https://aihorde.net/register 注册获取
AI_HORDE_API_KEY=your_api_key_here


# ---- LLM API (OpenAI 兼容接口) ----
# 支持 OpenAI / OpenRouter / 本地 Ollama / 自定义兼容 API
# config.yaml 中 llm.api_base 可自定义 API 地址
OPENAI_API_KEY=sk-your_api_key_here
# OPENAI_API_BASE=https://api.openai.com/v1   # config.yaml 中已配置，此处备选


# ---- 网络代理（可选，国内访问 HuggingFace / CivitAI 等需要） ----
# 若使用 VPN，以下通常无需设置
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,.local


# ---- HuggingFace 镜像（可选，国内加速模型下载） ----
# 若工作流中涉及模型下载，可设置国内镜像
# HF_ENDPOINT=https://hf-mirror.com


# ---- 日志级别覆盖（可选） ----
# 会覆盖 config.yaml 中的 logging.level
# LOG_LEVEL=DEBUG


# ---- 输出目录覆盖（可选） ----
# 会覆盖 config.yaml 中的 output.directory
# OUTPUT_DIR=my_output
